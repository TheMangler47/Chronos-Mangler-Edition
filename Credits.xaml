<Window x:Class="Chronos.Credits"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:Chronos"
        mc:Ignorable="d" 
        Height="450"
        Width="800"
        MinWidth="600"
        MinHeight="350"
        WindowStyle="None"
        AllowsTransparency="True"
        Title="Chronos — Credits"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource Poppins}"
        Foreground="{DynamicResource PrimaryWindowForegroundBrush}"
        Background="{DynamicResource PrimaryWindowBrush}">

    <Window.Resources>
        <Style x:Key="CreditSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryMenuItemForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="CreditNameStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryWindowForegroundBrush}"/>
        </Style>

        <Style x:Key="CreditRoleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryMenuItemForegroundBrush}"/>
        </Style>

        <Style x:Key="CreditCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SecondaryWindowBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0" 
                    Width="48" 
                    Height="48" 
                    CornerRadius="10" 
                    Background="{DynamicResource TertiaryWindowBrush}" 
                    Margin="0,0,16,0">
                <TextBlock Text="C" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           Foreground="{DynamicResource PrimaryWindowForegroundBrush}"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Chronos" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource PrimaryWindowForegroundBrush}"/>
                    <Border Background="{DynamicResource TertiaryWindowBrush}" 
                            CornerRadius="4" 
                            Padding="6,2" 
                            Margin="10,0,0,0" 
                            VerticalAlignment="Center">
                        <TextBlock Text="Mangler Edition" 
                                   FontSize="11" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource PrimaryWindowForegroundBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Version 1.0.0 — Acknowledgments &amp; Third-Party Notices" 
                           FontSize="12" 
                           Foreground="{DynamicResource SecondaryMenuItemForegroundBrush}" 
                           Margin="0,3,0,0"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,12,0">

                <Border Style="{StaticResource CreditCardStyle}">
                    <StackPanel>
                        <TextBlock Text="CORE DEVELOPERS &amp; MAINTAINERS" Style="{StaticResource CreditSectionHeaderStyle}"/>

                        <Grid Margin="0,4,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Base Developer" Style="{StaticResource CreditRoleStyle}"/>
                            <TextBlock Text="Nam3" Grid.Column="1" Style="{StaticResource CreditNameStyle}"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Fork Owner &amp; Lead Contributor" Style="{StaticResource CreditRoleStyle}"/>
                            <TextBlock Text="TheMangler47 / Soulzay" Grid.Column="1" Style="{StaticResource CreditNameStyle}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CreditCardStyle}">
                    <StackPanel>
                        <TextBlock Text="LIBRARIES &amp; FRAMEWORKS" Style="{StaticResource CreditSectionHeaderStyle}"/>

                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="WPF / .NET Framework" Style="{StaticResource CreditNameStyle}"/>
                                <TextBlock Text="Core UI framework &amp; desktop runtime environment" Style="{StaticResource CreditRoleStyle}"/>
                            </StackPanel>
                            <TextBlock Text="Microsoft" Grid.Column="1" Style="{StaticResource CreditRoleStyle}" VerticalAlignment="Center"/>
                        </Grid>

                        <Rectangle Height="1" Fill="{DynamicResource WindowBorderBrush}" Margin="0,8"/>

                        <Grid Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Poppins Font Family" Style="{StaticResource CreditNameStyle}"/>
                                <TextBlock Text="Open-source geometric sans-serif typeface" Style="{StaticResource CreditRoleStyle}"/>
                            </StackPanel>
                            <TextBlock Text="Google Fonts / ITF" Grid.Column="1" Style="{StaticResource CreditRoleStyle}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CreditCardStyle}">
                    <StackPanel>
                        <TextBlock Text="SPECIAL THANKS" Style="{StaticResource CreditSectionHeaderStyle}"/>
                        <TextBlock Text="&quot;Thank you Hip Hop for Keeping us Alive And Sane.&quot;" 
                                   FontSize="13" 
                                   FontStyle="Italic"
                                   TextWrapping="Wrap" 
                                   Foreground="{DynamicResource PrimaryWindowForegroundBrush}" 
                                   LineHeight="20"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button x:Name="button_GitHub"
                        Content="GitHub Repository" 
                        Padding="10,0"
                        Height="28" 
                        Style="{DynamicResource RoundedButtonStyle}"
                        Background="Transparent"
                        Foreground="{DynamicResource SecondaryMenuItemForegroundBrush}"
                        FontSize="12"
                        Click="button_GitHub_Click"/>
            </StackPanel>

            <Button x:Name="button_Close"
                    Content="Close" 
                    Width="90" 
                    Height="32" 
                    HorizontalAlignment="Right"
                    Style="{DynamicResource RoundedButtonStyle}"
                    Background="{DynamicResource TertiaryWindowBrush}"
                    Foreground="{DynamicResource PrimaryWindowForegroundBrush}"
                    Click="button_Close_Click"/>
        </Grid>
    </Grid>
</Window>