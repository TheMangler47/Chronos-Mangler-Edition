<Window x:Class="Chronos.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:Chronos"
        mc:Ignorable="d" 
        Height="450"
        Width="800"
        MinWidth="600"
        MinHeight="350"
        WindowStyle="None"
        AllowsTransparency="True"
        Title="Settings"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource Poppins}"
        Foreground="{DynamicResource PrimaryWindowForegroundBrush}"
        Background="{DynamicResource PrimaryWindowBrush}">

    <Window.Resources>
        <Style x:Key="SettingSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryMenuItemForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryWindowForegroundBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Settings" 
                       FontSize="22" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource PrimaryWindowForegroundBrush}"/>
            <TextBlock Text="Customize editor preferences and application appearance" 
                       FontSize="12" 
                       Foreground="{DynamicResource SecondaryMenuItemForegroundBrush}" 
                       Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Grid.Row="1">
            <StackPanel Margin="0,0,15,0">

                <Border BorderBrush="{DynamicResource WindowBorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        Padding="0,0,0,20" 
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Appearance" Style="{StaticResource SettingSectionHeaderStyle}"/>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Theme" Style="{StaticResource SettingLabelStyle}"/>
                            <ComboBox x:Name="comboBox_Theme" 
                                      Grid.Column="1" 
                                      Height="28"
                                      SelectionChanged="comboBox_Theme_SelectionChanged" VerticalAlignment="Top">
                                <ComboBoxItem Content="Dark" IsSelected="True"/>
                                <ComboBoxItem Content="Light"/>
                                <ComboBoxItem Content="System Default"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Show Line Numbers by default" Style="{StaticResource SettingLabelStyle}"/>
                            <CheckBox x:Name="checkBox_LineNumbers" 
                                      Grid.Column="1" 
                                      IsChecked="True" 
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource WindowBorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        Padding="0,0,0,20" 
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Editor Settings" Style="{StaticResource SettingSectionHeaderStyle}"/>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Font Family" Style="{StaticResource SettingLabelStyle}"/>
                            <ComboBox x:Name="comboBox_FontFamily" 
                                      Grid.Column="1" 
                                      Height="28" 
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Poppins"/>
                                <ComboBoxItem Content="Consolas"/>
                                <ComboBoxItem Content="Cascadia Code"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Font Size" Style="{StaticResource SettingLabelStyle}"/>
                            <TextBox x:Name="textBox_FontSize" 
                                     Grid.Column="1" 
                                     Height="28" 
                                     Text="14" 
                                     VerticalContentAlignment="Center" 
                                     Padding="5,0"/>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Enable Word Wrap" Style="{StaticResource SettingLabelStyle}"/>
                            <CheckBox x:Name="checkBox_WordWrap" 
                                      Grid.Column="1" 
                                      IsChecked="False" 
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource WindowBorderBrush}" 
                        BorderThickness="0,0,0,0" 
                        Padding="0,0,0,10" 
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Interface" Style="{StaticResource SettingSectionHeaderStyle}"/>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Show Explorer Sidebar on startup" Style="{StaticResource SettingLabelStyle}"/>
                            <CheckBox x:Name="checkBox_ShowSidebar" 
                                      Grid.Column="1" 
                                      IsChecked="True" 
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Show Status Bar on startup" Style="{StaticResource SettingLabelStyle}"/>
                            <CheckBox x:Name="checkBox_ShowStatusBar" 
                                      Grid.Column="1" 
                                      IsChecked="True" 
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Always on top" Style="{StaticResource SettingLabelStyle}"/>
                            <CheckBox x:Name="checkBox_AlwaysOnTop" 
          Grid.Column="1" 
          IsChecked="False" 
          VerticalAlignment="Center"
          Checked="checkBox_AlwaysOnTop_Click"
          Unchecked="checkBox_AlwaysOnTop_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,15,0,0">
            <Button x:Name="button_SaveSettings"
                    Content="Save Changes" 
                    Width="120" 
                    Height="32" 
                    Margin="0,0,10,0"
                    Style="{DynamicResource RoundedButtonStyle}"
                    Background="{DynamicResource TertiaryWindowBrush}"
                    Foreground="{DynamicResource PrimaryWindowForegroundBrush}"
                    Click="button_SaveSettings_Click"/>
            <Button x:Name="button_Close"
                    Content="Close" 
                    Width="90" 
                    Height="32" 
                    Style="{DynamicResource RoundedButtonStyle}"
                    Background="Transparent"
                    Foreground="{DynamicResource SecondaryMenuItemForegroundBrush}"
                    Click="button_Close_Click"/>
        </StackPanel>
    </Grid>
</Window>